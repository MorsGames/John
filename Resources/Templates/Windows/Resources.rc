#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @JOHN_WINDOWS_VERSION@
PRODUCTVERSION  @JOHN_WINDOWS_VERSION@
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "ProductName", "@JOHN_DISPLAY_NAME@"
            VALUE "CompanyName", "@JOHN_COMPANY_NAME@"
            VALUE "FileDescription", "@JOHN_DESCRIPTION@"
            VALUE "FileVersion", "@JOHN_VERSION@"
            VALUE "InternalName", "@JOHN_TARGET@"
            VALUE "LegalCopyright", ""
            VALUE "OriginalFilename", "@JOHN_TARGET@.exe"
            VALUE "ProductVersion", "@JOHN_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END

@JOHN_WINDOWS_ICON_RESOURCE@
