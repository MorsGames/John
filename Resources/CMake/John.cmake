add_compile_definitions(${john_platform_definitions} ${john_configuration_definitions})

foreach(configuration IN LISTS JOHN_CUSTOM_CONFIGURATIONS)
    string(TOUPPER "${configuration}" configurationUpper)
    string(TOUPPER "${JOHN_CONFIGURATION_BASE_${configuration}}" baseUpper)

    foreach(flags CMAKE_C_FLAGS CMAKE_CXX_FLAGS CMAKE_EXE_LINKER_FLAGS CMAKE_SHARED_LINKER_FLAGS CMAKE_MODULE_LINKER_FLAGS CMAKE_STATIC_LINKER_FLAGS)
        if(NOT DEFINED ${flags}_${configurationUpper})
            set(${flags}_${configurationUpper} "${${flags}_${baseUpper}}" CACHE STRING "Flags for ${configuration} builds")
        endif()
    endforeach()
endforeach()

function(john_add_game target)
    cmake_parse_arguments(PARSE_ARGV 1 GAME "" "" "SOURCES")
    if(GAME_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "john_add_game(${target}) only takes SOURCES, not: ${GAME_UNPARSED_ARGUMENTS}. The rest of the game's settings go in John.json.")
    endif()
    set(fragment "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/Games/${target}.cmake")
    if(NOT EXISTS "${fragment}")
        message(FATAL_ERROR "${target} isn't a game in John.json!")
    endif()
    include("${fragment}")
    target_sources(${target} PRIVATE ${GAME_SOURCES})
endfunction()
